# The one place the build's source versions are pinned.
# Read by every workflow (appended to $GITHUB_ENV) and substituted into
# patches/lgpl.patch (@FFMPEG_TAG@, @MPV_TAG@). Change a pin here only.
#
# CMAKE_SHA   commit of Kosm8/mpv-winbuild-cmake whose recipes we patch
# MPV_TAG     official mpv release tag (github.com/mpv-player/mpv)
# FFMPEG_TAG  FFmpeg release tag (github.com/FFmpeg/FFmpeg)
CMAKE_SHA=ff7fbaabcd6549aecf5fbb609da88c8d87085007
MPV_TAG=v0.42.0
FFMPEG_TAG=n9.0.2
